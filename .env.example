APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Require 12+ character passwords with mixed case, numbers and symbols.
AUTH_STRICT_PASSWORDS=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAILPIT CONFIGURATION
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@beciss.local"
MAIL_FROM_NAME="${APP_NAME}"

# GMAIL SMTP PRODUCTION MAIL SETTINGS
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=000
# MAIL_USERNAME=xx@gmail.com
# MAIL_PASSWORD=xxx
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=xxx@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"

# DEFAULT MAILER
# MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SMS (IPROG, same account as IRF-CES)
# Drivers: iprogsms (sends for real, costs credits) | log (storage/logs/sms.log) | none
# Try it with: php artisan test:sms 09171234567 "Test message"
SMS_DRIVER=log
SMS_FROM="${APP_NAME}"
SMS_COUNTRY_CODE=63
SMS_LOG_CHANNEL=sms
IPROGSMS_TOKEN=
# Smart/TNT/Sun need a sender name approved by IPROG; until then they are refused.
IPROGSMS_SENDER_NAME_APPROVED=false
# IPROG prepends this name to every message; keep it identical to the IPROG dashboard.
IPROGSMS_SENDER_NAME=
